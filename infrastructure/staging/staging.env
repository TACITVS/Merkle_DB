# MerkleDB Staging Environment Configuration
# Copy to .env and customize for your staging environment

# Application
MERKLEDB_PORT=4001
MERKLEDB_HOST=0.0.0.0
MIX_ENV=staging

# Authentication
MERKLEDB_REQUIRE_AUTH=true
MERKLEDB_API_KEY=staging_test_key_change_in_production

# Rate Limiting
MERKLEDB_RATE_LIMIT_ENABLED=true
MERKLEDB_RATE_LIMIT_PER_SECOND=100

# Raft Consensus
RAFT_ELECTION_TIMEOUT_MIN=1000
RAFT_ELECTION_TIMEOUT_MAX=2000
RAFT_HEARTBEAT_INTERVAL=200

# Erlang VM
RELEASE_NODE=merkledb@staging-node1
RELEASE_COOKIE=staging_cookie_change_me
ERL_MAX_PORTS=65536
ERL_MAX_ETS_TABLES=10000

# Storage
MERKLEDB_DATA_DIR=./data/staging
MERKLEDB_BACKUP_DIR=/var/backups/merkledb-staging

# Telemetry
MERKLEDB_TELEMETRY_ENABLED=true
MERKLEDB_TELEMETRY_WINDOW_SIZE=100

# Logging
LOG_LEVEL=info

# Resources (Lower limits for staging)
MERKLEDB_MAX_TREE_SIZE_GB=5
MERKLEDB_MAX_VECTOR_COUNT=1000000

# Testing flags
MERKLEDB_ENABLE_DEBUG_ENDPOINTS=true
MERKLEDB_ALLOW_UNSAFE_OPERATIONS=true
