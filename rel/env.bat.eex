@echo off
rem MerkleDb Release Environment Configuration
rem This file is evaluated at runtime, not build time.

rem Set the release node name
if "%RELEASE_NODE%"=="" set RELEASE_NODE=merkle_db@127.0.0.1

rem Set the release distribution protocol
if "%RELEASE_DISTRIBUTION%"=="" set RELEASE_DISTRIBUTION=sname

rem Set the release cookie (for distributed Erlang)
rem IMPORTANT: Change this in production!
if "%RELEASE_COOKIE%"=="" set RELEASE_COOKIE=<%= System.get_env("RELEASE_COOKIE") || "merkle_db_default_cookie_change_me" %>

rem Set the release VM arguments file
if "%RELEASE_VM_ARGS%"=="" set RELEASE_VM_ARGS=%RELEASE_ROOT%\releases\%RELEASE_VSN%\vm.args

rem Set the release configuration directory
if "%RELEASE_CONFIG_DIR%"=="" set RELEASE_CONFIG_DIR=%RELEASE_ROOT%

rem MerkleDb specific environment variables
rem These can be overridden by the user

rem HTTP port (default: 4000)
if "%MERKLE_DB_HTTP_PORT%"=="" set MERKLE_DB_HTTP_PORT=4000

rem HTTPS port (default: 4443)
if "%MERKLE_DB_HTTPS_PORT%"=="" set MERKLE_DB_HTTPS_PORT=4443

rem Data directory
if "%MERKLE_DB_DATA_DIR%"=="" set MERKLE_DB_DATA_DIR=%RELEASE_ROOT%\data

rem Log level (debug, info, warning, error)
if "%MERKLE_DB_LOG_LEVEL%"=="" set MERKLE_DB_LOG_LEVEL=info

rem Create data directory if it doesn't exist
if not exist "%MERKLE_DB_DATA_DIR%" mkdir "%MERKLE_DB_DATA_DIR%"
