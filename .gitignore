# ==============================================================================
# MerkleDB .gitignore
# Only source code is tracked. Clone and run build_production.bat to compile.
# ==============================================================================

# ------------------------------------------------------------------------------
# Elixir/Mix Build Artifacts
# ------------------------------------------------------------------------------
/_build/
/deps/
/cover/
/doc/
/.fetch
erl_crash.dump
*.ez
merkle_db-*.tar

# ------------------------------------------------------------------------------
# Compiled Native Code (regenerated by build_production.bat)
# ------------------------------------------------------------------------------

# Object files
*.obj
*.o

# Shared libraries
*.dll
*.so
*.dylib

# Static libraries
*.a
*.lib

# Executables
*.exe

# ------------------------------------------------------------------------------
# Data & Runtime Files
# ------------------------------------------------------------------------------

# Snapshot data (user-generated)
/data/
*.dets
*.node

# Log files
*.log
server.err.log
server.out.log

# Temporary files
/tmp/
*.tmp
nul

# Build/compile output logs
compile_*.txt
gcc_error.txt
*_error.txt
*_output.txt

# Test files (temporary)
test_*.c
test_*.bat

# Obsolete/unused NIF files
native/fp_query_nif.c

# Old/intermediate build scripts (keep only build_production.bat)
build_all.bat
build_ivf_fix.bat

# ------------------------------------------------------------------------------
# IDE & Editor Files
# ------------------------------------------------------------------------------
.idea/
.vscode/
.claude/
.codex/
.aider/
.cursor/
.windsurf/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ------------------------------------------------------------------------------
# Scripts Output (build artifacts)
# ------------------------------------------------------------------------------
/scripts/output/
*.bin

# ------------------------------------------------------------------------------
# Generated Documentation (keep only spec/)
# ------------------------------------------------------------------------------
/docs/fp_asm_catalog_*.md
/docs/fp_asm_inventory_*.md

# Keep: /docs/spec/ (specification documents)

# ------------------------------------------------------------------------------
# Keep These (source code)
# ------------------------------------------------------------------------------
# !priv/static/  # Static web assets if any
# !native/fp_lib/  # C source code (submodule)
